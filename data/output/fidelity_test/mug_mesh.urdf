<?xml version="1.0"?>
<robot name="mug">
  <link name="base">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="mug_mesh.stl"/></geometry>
      <material name="orange"><color rgba="0.9 0.5 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="mug_mesh.stl"/></geometry>
    </collision>
  </link>
</robot>
